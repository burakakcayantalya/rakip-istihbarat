# ============================================
# Rakip İçerik İstihbarat Sistemi V2
# Çevre Değişkenleri
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin
# cp .env.example .env

# Uygulama Ayarları
APP_NAME="Rakip İstihbarat Sistemi"
APP_VERSION="2.0.0"
DEBUG=true
SECRET_KEY="your-secret-key-change-this-in-production"

# Sunucu Ayarları
HOST=0.0.0.0
PORT=8000

# Veritabanı
DATABASE_URL=sqlite:///./database.db

# ============================================
# API KEYS
# ============================================

# Google Search API (RapidAPI)
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=google-search116.p.rapidapi.com

# Gemini AI API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# ============================================
# TARAMA AYARLARI
# ============================================

# Tarama sıklığı (saat)
SCAN_INTERVAL_HOURS=6

# Değişim eşiği (yüzde) - bunun altındaki değişimler görmezden gelinir
CHANGE_THRESHOLD_PERCENT=5

# Maksimum eşzamanlı tarama
MAX_CONCURRENT_SCANS=3

# İstek arası bekleme (saniye) - anti-bot koruması için
REQUEST_DELAY_SECONDS=2
